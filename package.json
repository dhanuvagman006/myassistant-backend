    "test:fulfillment": "node scripts/fulfillment-test.js",
    "test:legal": "node scripts/legal-test.js",
    "test:knowledge": "node scripts/knowledge-test.js",
    "test:professional": "node scripts/professional-test.js",
    "test:integrations": "node scripts/integrations-test.js",
