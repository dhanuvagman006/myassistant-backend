PORT=3000

# AI provider — GEMINI ONLY. One key powers chat, streaming and voice
# transcription. Get one at aistudio.google.com
GEMINI_API_KEY=
# MODEL LIFECYCLE: Google retires models on a schedule and a retired name
# returns 404 on EVERY call. gemini-2.0-* was shut down 2026-06-01 and the
# gemini-2.5-* family is scheduled for 2026-10-16. Check the current list at
# https://ai.google.dev/gemini-api/docs/models before setting these.
GEMINI_MODEL=gemini-3.5-flash
# LATENCY — the most important knob for the voice loop. Gemini 3 models think
# before answering and default to "high", which adds seconds of silence before
# Hari starts speaking. Conversation needs almost no reasoning, so we default
# to "low". Options: minimal | low | medium | high (support varies by model;
# "low" works on every Gemini 3 model). Ignored on gemini-2.x. If the value is
# rejected the server logs it once and continues without it.
GEMINI_THINKING_LEVEL=low
# Optional: dedicated model for speech-to-text. Transcription is an easy task,
# so a lighter model transcribes faster with no hit to chat quality. Leave
# BLANK to reuse GEMINI_MODEL — that is the safe default, and gemini-3.5-flash
# accepts audio input directly. If you set it and the model has been retired,
# the server logs the problem once and falls back to GEMINI_MODEL
# automatically rather than breaking voice input.
GEMINI_STT_MODEL=
# The model a chat turn moves to when GEMINI_MODEL is out of quota or retired
# (404). Blank = gemini-flash-lite-latest. Unset model settings default to
# the -latest aliases, which Google keeps pointed at its current models.
GEMINI_FALLBACK_MODEL=

# THE APP'S OWN MODELS (Firebase AI Logic, 2026-09-29). The phone calls the
# models itself — Gemini Nano on the device, Gemini in the cloud through
# Firebase AI Logic — and this server is its tool server (GET /ai/config,
# POST /ai/context, /ai/tool, /ai/turn, /ai/firebase-token). These only
# tell the app WHICH models to use; the key lives in Firebase, not here.
# Blank = the defaults shown.
# AI_CLOUD_MODEL=            # the conversation's cloud model (default GEMINI_MODEL)
# AI_CLOUD_FAST_MODEL=       # quick cloud model (default gemini-flash-lite-latest)
# AI_TTS_MODEL=              # the voice (default GEMINI_TTS_MODEL below)
# AI_TTS_VOICE=              # default voice when the user chose none (default Kore)
# AI_LIVE_MODEL=             # the app's fast Live voice, build ≥135 (default gemini-3.8-live)
# AI_LIVE_VOICE=             # its voice (default Callirrhoe, chosen by test 2026-09-30)
# AI_NANO=off                # never use Gemini Nano on the phone (default on)
# AI_APPROVAL_SECRET=        # signs "yes, go ahead" tokens (default: derived from JWT_SECRET)
# The native-audio Live model: the default for the app's hands-free mode
# (AI_LIVE_MODEL), and the model the phone-call bridge (src/phone) speaks with.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview
# The speech model the app's voice defaults to. It MUST stay a dedicated
# *-tts model: gemini-3.5-flash accepts audio IN but cannot generate audio
# OUT, so it cannot serve as the voice.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Shared secret the Android app must send as X-App-Key
APP_API_KEY=change-me-to-a-long-random-string

# Google Sign-In (F1) — the *Web* OAuth client ID from Google Cloud Console.
# Must match GOOGLE_WEB_CLIENT_ID in the Android app's build.gradle.kts.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Dev-only fallback: allow X-App-Key auth (never set true in production)
ALLOW_APP_KEY=true   # dev mode — set false before production

# Dev mode: skip all auth. MUST be removed/false in production.
AUTH_DISABLED=true

# Session signing secret — 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Apple Sign In — your iOS bundle id (audience of Apple's identity token)
APPLE_BUNDLE_ID=com.yourorg.myassistant

# Where user document FILES live (mount a Docker volume here)
DATA_DIR=./data

# Postgres (docker-compose wires this automatically)
#DATABASE_URL=postgres://myassistant:localdev@localhost:5432/myassistant

# --- Admin stats (GET /admin/stats with X-Admin-Key) ---
# 16+ random chars; endpoint is invisible (404) while unset.
ADMIN_KEY=


# --- Agent calls (Hari phones a contact on your behalf, via Plivo) ---
# Feature returns 503 (app falls back to a direct dial) while unset.
# Get credentials + a voice-enabled number at console.plivo.com.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=          # your Plivo number in E.164, e.g. +14155550123
# HTTPS URL Plivo can reach for call webhooks (this server's public address).
PUBLIC_BASE_URL=
# Optional: Plivo <Speak> voice (Amazon Polly). Aditi = Indian English/Hindi.
PLIVO_VOICE=Polly.Aditi
# Optional: max agent calls placed per user per day (default 20).
AGENT_CALL_DAILY_LIMIT=20

# ---- AGENT RUNTIME (Phase 1) ----
# The model selects capabilities from the tool registry via function-calling
# instead of hard-coded regexes. Set to false to fall back to the legacy
# intent chain while validating.
AGENT_RUNTIME=true

# Web search provider for the web_search tool. WITHOUT one of these the tool
# reports honestly that search is unavailable — it never invents results.
# Pick ONE:
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---- MCP (external tool servers, per user) ----
# Encrypts MCP credentials at rest (AES-256-GCM). Falls back to JWT_SECRET
# if unset. Rotating it invalidates stored credentials by design.
MCP_SECRET_KEY=
MCP_CONNECT_TIMEOUT_MS=12000
MCP_CALL_TIMEOUT_MS=30000

# ---- EMBEDDINGS (semantic recall) ----
# Provider abstraction: gemini (uses GEMINI_API_KEY) or openai. Leave unset
# to auto-pick whichever key exists; with none, recall ranks lexically.
EMBEDDING_PROVIDER=
GEMINI_EMBED_MODEL=gemini-embedding-001
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# PRODUCTION: use image pgvector/pgvector:pg16 and migrate the JSON
# embedding columns to vector(768) — see src/memory/embeddings.js.

# ---- FLIGHTS (real provider; no fabricated results without one) ----
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# DUFFEL_API_TOKEN=

# ---- OBSERVABILITY / JOBS ----
LOG_LEVEL=info
JOB_POLL_MS=2000
# /metrics/agent is protected when METRICS_TOKEN is set.

# --- Live Avatar cost guards (HeyGen bills per minute of rendered video) ---
AVATAR_ATTACH_GRACE_MS=45000
AVATAR_MAX_SESSION_MS=900000

# --- Avatar provider: HeyGen LiveAvatar (LITE mode) ---
# https://app.heygen.com → API key. LITE ≈ $0.10/min on paid plans. With
# HEYGEN_SANDBOX=true (default) sessions are FREE — no credits — but capped
# at ~1 minute and always render the stock "Wayne" avatar. Set it to false
# once a LiveAvatar plan is active, and pick a real HEYGEN_AVATAR_ID.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_SANDBOX=true
HEYGEN_QUALITY=high
HEYGEN_MAX_SESSION_S=900

# ---------------------------------------------------------------------------
# FULFILLMENT — ordering, rides, tickets, appointments
# ---------------------------------------------------------------------------
# Booking BY PHONE (book_by_calling_business) reuses the Plivo credentials
# above: Hari dials the business, asks, and reports what they said. With no
# Plivo config the tool reports that it cannot call — it never pretends.
#
# Deep-link handoffs (order_food, book_ride, book_movie_tickets) need no key.
# Swiggy, Zomato, BookMyShow and Ola publish no consumer ordering API and
# Uber's is partner-gated, so Hari prepares the order and the user completes
# payment in the provider's own app. If you obtain a real partner key, add an
# adapter in src/fulfillment/service.js (PROVIDER_ADAPTERS) and that provider
# switches from handoff to a genuine API booking.

# Optional: makes "play <song>" actually PLAY instead of opening a results
# list. One YouTube Data API v3 search resolves the video id, and the app
# opens /watch?v=… which starts immediately. Without it, play_music falls
# back to YouTube search results and says so.
# Free quota 10k units/day; a search costs 100 (~100 songs/day).
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# INBOUND CALLING — Hari answers the user's phone
# ---------------------------------------------------------------------------
# Reuses the Plivo credentials above plus PUBLIC_BASE_URL. In the Plivo
# console, point the number's Answer URL at:
#   POST {PUBLIC_BASE_URL}/inbound/plivo/answer
# then assign it to a user:
#   curl -X POST {PUBLIC_BASE_URL}/inbound/admin/assign-number \
#     -H "X-Admin-Key: $ADMIN_KEY" -H 'content-type: application/json' \
#     -d '{"phone":"+91XXXXXXXXXX","user_id":1}'
# Screening behaviour is per-user via PATCH /inbound/settings, not env.

# Optional: speech recognition language for inbound callers (default en-IN).
PLIVO_ASR_LANG=en-IN

# ---------------------------------------------------------------------------
# PROACTIVE — commitment nudges and pre-meeting briefs
# ---------------------------------------------------------------------------
# How often the background sweep runs (ms, default 10 minutes).
PROACTIVE_SWEEP_MS=600000
# How long before a meeting the brief is pushed (ms, default 25 minutes).
MEETING_BRIEF_LEAD_MS=1500000
# Local hours during which non-urgent notifications are held back.
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# ---------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS
# ---------------------------------------------------------------------------
# MEETING NEGOTIATION needs no new keys — it uses the Plivo credentials above
# plus a linked Google Calendar. Working hours it may offer within:
WORK_HOURS_START=10
WORK_HOURS_END=18

# PAYMENT COLLECTION (Razorpay Payment Links). Test-mode keys work end to
# end, which is what makes this demonstrable without a live merchant account.
# Money is only ever requested INTO the user's account — there is no payout
# path in the code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for the paid notification. Without it the webhook rejects
# everything, because an unverified webhook could mark any invoice paid.
# In the Razorpay dashboard add a webhook for payment_link.paid pointing at:
#   {PUBLIC_BASE_URL}/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# FLIGHT SEARCH + FARE WATCH. The adapter is already written; these keys
# switch it on. Amadeus self-service has a free tier.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test | production — these are SEPARATE hosts with separate credentials.
# Live keys against the test host return inventory that cannot be booked.
AMADEUS_ENV=test
# Alternative provider (first configured wins):
DUFFEL_API_TOKEN=

# INTERPRETER MODE needs no keys — the live model is already multilingual.

# --- Exotel agent calling (preferred over Plivo when set) ---
# Get these from your Exotel dashboard once KYC is done:
#   API key + token: Settings -> API
#   EXOTEL_SID: your account sid (in the dashboard URL)
#   EXOTEL_SUBDOMAIN: api.in.exotel.com (Mumbai) or api.exotel.com (Singapore)
#   EXOTEL_FROM_NUMBER: your ExoPhone (virtual number)
#   EXOTEL_FLOW_APP_ID: the App Bazaar flow id (see DEPLOYMENT notes)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_FROM_NUMBER=
EXOTEL_FLOW_APP_ID=

# --- Photo cards (2026-09-26) ---
# Gift cards with the user's words, a real photo and a signature, drawn on
# the phone. The photo is cleaned up with ffmpeg (no AI). POSTER_AI_RESTORE
# is the switch a later AI photo repair would sit behind; v1 has none, so
# it stays off and /posters/photos/:id/restore answers 503 'off'.
POSTER_AI_RESTORE=off
# Working photos and drafts untouched this many days are swept daily.
POSTER_RETENTION_DAYS=30

# --- Images: generation, editing, AI Poster Studio (2026-09-30) ---
# Every provider is inert until its key exists; the chain picks the best
# AVAILABLE one per purpose (src/services/imagegen.js) and ends at the
# keyless Pollinations tier. Values stay empty here — set them in the
# deployment's secret, never in this file.
#
# Gemini image output has NO free tier. on = the key's project has
# billing (tried first, short cooldown on 429); auto (default) = probe,
# 6 h cooldown on a quota answer; off = never called.
GEMINI_IMAGE_BILLING=
# Optional separate key for image calls (a billed project), so text stays
# on the free-tier key. Default: GEMINI_API_KEY.
GEMINI_IMAGE_API_KEY=
# Default gemini-3.1-flash-image. gemini-2.5-flash-image (shut down
# 2026-10-02) is replaced automatically if named here.
GEMINI_IMAGE_MODEL=
# Style Studio's editors, comma list. Default gemini-3-pro-image,gemini-3.1-flash-image.
GEMINI_EDIT_MODELS=
# Veo video model. Default veo-3.1-fast-generate-preview.
VEO_MODEL=
#
# Cloudflare Workers AI: FLUX.2 klein 4B on the free 10k neurons/day
# (~95 images/day). Token needs Workers AI permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Default @cf/black-forest-labs/flux-2-klein-4b (multipart form).
CF_IMAGE_MODEL=
# Tried after klein. Default @cf/black-forest-labs/flux-1-schnell; off to skip.
CF_FALLBACK_IMAGE_MODEL=
# Longest side requested from Cloudflare (default 1280; each 512px tile costs neurons).
CF_IMAGE_MAX_EDGE=
# schnell steps, 1-8 (default 8).
CF_IMAGE_STEPS=
#
# fal.ai (Authorization: Key …): qwen-image-2512 for pictures with words,
# z-image turbo for photos, qwen-image-edit-2511 for edits, birefnet for
# background removal, esrgan for upscaling.
FAL_KEY=
# off switches fal off with the key still set (default on).
FAL_IMAGES=
# Default fal-ai/z-image/turbo.
FAL_IMAGE_MODEL=
# Default fal-ai/qwen-image-2512.
FAL_TEXT_IMAGE_MODEL=
# Default fal-ai/qwen-image-edit-2511.
FAL_EDIT_MODEL=
# Default fal-ai/birefnet/v2.
FAL_BG_MODEL=
# Default fal-ai/esrgan.
FAL_UPSCALE_MODEL=
# Longest side requested from fal (default 1536).
FAL_MAX_EDGE=
#
# Strictly opt-in: both need the model named on purpose (the old
# FLUX.1-schnell defaults were no longer served).
HF_TOKEN=
HF_IMAGE_MODEL=
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=
#
# Chain tuning. Order override, comma list of: gemini, fal-zimage,
# fal-qwen, cf-klein, cf-schnell, huggingface, together.
IMAGE_PROVIDER_ORDER=
# Per keyed provider (default 40000) and for the whole call (default 75000).
IMAGE_PROVIDER_TIMEOUT_MS=
IMAGE_TOTAL_BUDGET_MS=
# off drops the keyless Pollinations fallback (default on).
IMAGE_KEYLESS=
# off stops the fal esrgan upscale of too-small results (default on; needs FAL_KEY).
IMAGE_AI_UPSCALE=
#
# The prompt writer before an image (Gemini TEXT, free tier). off to skip.
IMAGE_PROMPT_ENHANCE=
# Default gemini-flash-lite-latest; timeout default 6000 ms.
IMAGE_PROMPT_MODEL=
IMAGE_PROMPT_TIMEOUT_MS=
#
# AI Poster Studio (/posters/ai/*, create_event_poster). off = 503 'off'.
POSTER_AI=
# Per user per day (defaults 60 and 30).
POSTER_AI_DESIGNS_PER_DAY=
POSTER_AI_BACKGROUNDS_PER_DAY=
# Default gemini-flash-lite-latest; timeout default 10000 ms.
POSTER_DESIGN_MODEL=
POSTER_DESIGN_TIMEOUT_MS=
# First app build with the studio screen (default 135).
POSTER_STUDIO_MIN_BUILD=
# How long the voice tool waits for the background (default 12000 ms).
POSTER_TOOL_WAIT_MS=
#
# Style Studio's virtual try-on providers (src/services/imageEditProviders.js).
FASHN_API_KEY=
FASHN_MODEL=
FASHN_MODE=
FASHN_RESOLUTION=
VERTEX_PROJECT_ID=
VERTEX_SA_JSON=
VERTEX_LOCATION=
VERTEX_VTO_MODEL=

# ── Spoken morning brief + meeting prep (2026-09-30) — all optional ──
# BRIEF_SCRIPT_AI=on            # off → the code-written script only
BRIEF_SCRIPT_MODEL=
BRIEF_SCRIPT_TIMEOUT_MS=
BRIEF_SCRIPT_CACHE_MIN=
# MEETING_PREP_AI=on
MEETING_PREP_MODEL=
MEETING_PREP_TIMEOUT_MS=
MEETING_PREP_CACHE_MIN=
BRIEF_TOOLS_MIN_BUILD=

# ── Gemini Live voice (app build ≥135) — all optional ──
# AI_LIVE=on                    # off → the app uses the classic voice
AI_LIVE_MODEL=
AI_LIVE_VOICE=
AI_LIVE_SILENCE_MS=
# AI_MEMORY_SCORING=on
AI_MEMORY_PICK=
# AI_LAST_RESULTS=on
